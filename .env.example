INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=my-super-secret-admin-token
INFLUXDB_ORG=stocks
INFLUXDB_BUCKET=stocks

# Optional: OpenAI API key for AI notes
OPENAI_API_KEY=

# Fetch interval in seconds (default: 300 = 5 minutes)
FETCH_INTERVAL_SECONDS=300

# Database URL for metadata (SQLite by default)
DATABASE_URL=sqlite:///./stocks_meta.db
